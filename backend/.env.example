APP_NAME=KBO Fans API
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
REQUEST_TIMEOUT_SECONDS=10
# Screen-data GET wall-clock guard. Timed-out sync work keeps its slot until it exits.
DATA_REQUEST_TIMEOUT_SECONDS=15
DATA_REQUEST_MAX_CONCURRENCY=8
DATA_REQUEST_QUEUE_TIMEOUT_SECONDS=0.1
KBO_BASE_URL=https://www.koreabaseball.com
KBO_RELAY_USER_ID=
KBO_RELAY_PASSWORD=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
PUSH_REGISTRY_PATH=backend/data/runtime/push_registry.json
LIVE_SCOREBOARD_STATE_PATH=backend/data/runtime/live_scoreboard.json
# Keep warm cadence independent from relay/push delivery polling.
# Warm interval + 5s scheduler jitter must stay within the live-state max age.
LIVE_SCOREBOARD_MAX_AGE_SECONDS=20
SCOREBOARD_WARM_INTERVAL_SECONDS=5
PUSH_SYNC_INTERVAL_SECONDS=5
PUSH_SYNC_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.kbofans.kboFans
APNS_AUTH_KEY_PATH=
APNS_AUTH_KEY_P8=
APNS_USE_SANDBOX=true
SNAPSHOT_DIR=
