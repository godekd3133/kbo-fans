[Unit]
Description=KBO Fans FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kbo-fans
Group=kbo-fans
WorkingDirectory=/opt/kbo-fans/current/backend
EnvironmentFile=/etc/kbo-fans/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kbo-fans/venv/bin/uvicorn kbo_fans_backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
