[Unit]
Description=KBO Fans push and Live Activity sync worker
After=network-online.target kbo-fans-api.service
Wants=network-online.target

[Service]
Type=simple
User=kbo-fans
Group=kbo-fans
WorkingDirectory=/opt/kbo-fans/current/backend
EnvironmentFile=/etc/kbo-fans/backend.env
Environment=SNAPSHOT_SEED_DIR=/opt/kbo-fans/current/backend/data/snapshots
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kbo-fans/venv/bin/python -m kbo_fans_backend.scheduler.live_activity_sync_loop
Restart=always
RestartSec=5
# A synchronous sync tick may be inside a bounded upstream/APNs request when
# deploy sends SIGTERM.  Do not let a wedged worker hold a rolling deploy open
# indefinitely; give the handler time to finish, then kill the remaining
# process group.
TimeoutStopSec=30s
KillMode=mixed
Nice=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
