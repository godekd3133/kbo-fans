# Copy to a local, untracked env file before deployment.
# Do not commit real account IDs, secret ARNs, private file paths, or secret values.
#
# This one file can drive:
# - ./scripts/push-live-preflight.sh --env-file /path/to/kbo-fans-aws.env --aws
# - ./scripts/aws-push-demo-deploy.sh
# - ./scripts/github-push-secrets.sh --env-file /path/to/kbo-fans-aws.env
#
# Fill the placeholders below, then upload GitHub Actions inputs with:
# - ./scripts/github-push-secrets.sh --env-file /path/to/kbo-fans-aws.env --apply
# Re-run setup status after each change:
# - ./scripts/push-demo-setup-status.sh --env-file /path/to/kbo-fans-aws.env --repo godekd3133/kbo-fans

# Keep ap-northeast-2 unless the AWS stack is intentionally moved.
export AWS_REGION=ap-northeast-2
export KBO_PUSH_STACK_NAME=kbo-fans-push-demo
export KBO_STACK_NAME_PREFIX=kbo-fans

# App Firebase client config files used by GitHub Actions build/deploy secrets.
# Source: Firebase Console > Project settings > Your apps.
# Target: GitHub secrets IOS_GOOGLE_SERVICE_INFO_PLIST / ANDROID_GOOGLE_SERVICES_JSON.
# If these files already exist in the repository default paths, github-push-secrets.sh
# can read them without these overrides.
export IOS_GOOGLE_SERVICE_INFO_PLIST_FILE=/path/to/GoogleService-Info.plist
export ANDROID_GOOGLE_SERVICES_JSON_FILE=/path/to/google-services.json

# Local backend secret source files used by ./scripts/aws-push-secrets.sh and
# ./scripts/github-push-secrets.sh.
# Firebase Admin source: Firebase Console > Project settings > Service accounts > Generate new private key.
# APNs source: Apple Developer > Certificates, Identifiers & Profiles > Keys > Apple Push Notifications service.
# Keep these as local file paths, not committed content.
export FIREBASE_SERVICE_ACCOUNT_FILE=/path/to/firebase-service-account.json
export APNS_AUTH_KEY_FILE=/path/to/AuthKey_XXXXXXXXXX.p8

# Non-secret app identifiers. Must match app Firebase client config files.
# FIREBASE_PROJECT_ID must match the Firebase client and Admin JSON project.
# APNS_KEY_ID is the Apple key id; APNS_TEAM_ID is the Apple Developer team id.
# Use APNS_USE_SANDBOX=false for TestFlight/App Store style production pushes.
export FIREBASE_PROJECT_ID=your-firebase-project-id
export APNS_KEY_ID=XXXXXXXXXX
export APNS_TEAM_ID=XXXXXXXXXX
export APNS_USE_SANDBOX=false

# Shared secret used to protect the backend scoreboard sync trigger.
# Generate with: openssl rand -hex 32
# Rotate if it was exposed.
export PUSH_SYNC_SECRET=replace_with_64_hex_random_value_generated_by_openssl_rand_hex_32

# KBO login used by the official LiveText relay crawler.
# Source: local secure storage only. Do not commit real credentials.
# Target: AWS Secrets Manager and GitHub secrets KBO_RELAY_USER_ID / KBO_RELAY_PASSWORD.
export KBO_RELAY_USER_ID=replace_with_kbo_login_id
export KBO_RELAY_PASSWORD=replace_with_kbo_login_password

# GitHub Actions runner AWS auth. Prefer OIDC role. If this is empty,
# github-push-secrets.sh requires AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# Preferred: run aws-github-oidc-role.sh --update-env-file and upload AWS_ROLE_TO_ASSUME.
# Fallback: use AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY only if OIDC cannot be created.
export AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/kbo-fans-github-actions
# export AWS_ACCESS_KEY_ID=
# export AWS_SECRET_ACCESS_KEY=

# Image / storage / role values created in AWS.
# ECR repository stores the backend image used by the always-on API and sync worker.
export ECR_REPOSITORY_URI=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/kbo-fans-backend
export KBO_BACKEND_IMAGE_TAG=latest
# Optional. Defaults to "$ECR_REPOSITORY_URI:latest" in the CloudFormation deploy script.
export CONTAINER_IMAGE_URI=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/kbo-fans-backend:latest
export ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/kbo-fans-ecs-task-execution
export ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/kbo-fans-ecs-task
export EFS_FILE_SYSTEM_ID=fs-00000000000000000

# Required only for the CloudFormation stack path.
# VPC/subnets are required by the CloudFormation ALB + ECS Fargate stack.
# Keep ENABLE_HTTPS=true for real iPhone/release use. Set false only for temporary HTTP-only AWS smoke deploys before a domain is ready.
export VPC_ID=vpc-00000000000000000
export PUBLIC_SUBNET_A_ID=subnet-00000000000000000
export PUBLIC_SUBNET_B_ID=subnet-11111111111111111
export ENABLE_HTTPS=true
export API_DOMAIN_NAME=
export ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:123456789012:certificate/00000000-0000-0000-0000-000000000000

# Sync worker tuning. Smart daily times use Asia/Seoul; set off to disable.
export PUSH_SYNC_INTERVAL_SECONDS=5
export PUSH_BASEBALL_INFO_SMART_DAILY_TIMES=09:30,16:00,22:30

# These are generated by ./scripts/aws-push-secrets.sh.
# You can also source outputs/aws/ecs-fargate/secrets.env instead.
# Leave empty until the local secret files above contain real values.
export SECRET_ARN_FIREBASE_SERVICE_ACCOUNT_JSON=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/firebase-service-account-json-xxxxxx
export SECRET_ARN_APNS_AUTH_KEY_P8=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/apns-auth-key-p8-xxxxxx
export SECRET_ARN_PUSH_SYNC_SECRET=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/push-sync-secret-xxxxxx
export SECRET_ARN_KBO_RELAY_USER_ID=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/kbo-relay-user-id-xxxxxx
export SECRET_ARN_KBO_RELAY_PASSWORD=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/kbo-relay-password-xxxxxx
