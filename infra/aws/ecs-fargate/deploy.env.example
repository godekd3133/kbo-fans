# Copy to a local, untracked env file before deployment.
# Do not commit real account IDs, secret ARNs, or private file paths.

export AWS_REGION=ap-northeast-2
export KBO_PUSH_STACK_NAME=kbo-fans-push-demo
export KBO_STACK_NAME_PREFIX=kbo-fans

# Local secret source files used by ./scripts/aws-push-secrets.sh.
export FIREBASE_SERVICE_ACCOUNT_FILE=/path/to/firebase-service-account.json
export APNS_AUTH_KEY_FILE=/path/to/AuthKey_XXXXXXXXXX.p8

# Non-secret app identifiers. Must match app Firebase client config files.
export FIREBASE_PROJECT_ID=your-firebase-project-id
export APNS_KEY_ID=XXXXXXXXXX
export APNS_TEAM_ID=XXXXXXXXXX

# Image / storage / role values created in AWS.
export ECR_REPOSITORY_URI=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/kbo-fans-backend
export KBO_BACKEND_IMAGE_TAG=latest
# Optional. Defaults to "$ECR_REPOSITORY_URI:latest" in the CloudFormation deploy script.
export CONTAINER_IMAGE_URI=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/kbo-fans-backend:latest
export ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/kbo-fans-ecs-task-execution
export ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/kbo-fans-ecs-task
export EFS_FILE_SYSTEM_ID=fs-00000000000000000

# Required only for the CloudFormation stack path.
export VPC_ID=vpc-00000000000000000
export PUBLIC_SUBNET_A_ID=subnet-00000000000000000
export PUBLIC_SUBNET_B_ID=subnet-11111111111111111
export ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:123456789012:certificate/00000000-0000-0000-0000-000000000000

# These are generated by ./scripts/aws-push-secrets.sh.
# You can also source outputs/aws/ecs-fargate/secrets.env instead.
export SECRET_ARN_FIREBASE_SERVICE_ACCOUNT_JSON=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/firebase-service-account-json-xxxxxx
export SECRET_ARN_APNS_AUTH_KEY_P8=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/apns-auth-key-p8-xxxxxx
export SECRET_ARN_PUSH_SYNC_SECRET=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:kbo-fans/push-sync-secret-xxxxxx
